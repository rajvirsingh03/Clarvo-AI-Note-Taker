# =============================================================================
# Clarvo AI — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard → Project Settings → API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------------------
# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
# Configure as an OAuth 2.0 Client ID — Web application type
# Redirect URI: https://your-project-ref.supabase.co/auth/v1/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=1021281802286-gktec1lbuau8sfbqv56mufvfmsr9nerk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# -----------------------------------------------------------------------------
# Notion OAuth (https://www.notion.so/my-integrations → Create Integration)
# Type: Public integration (OAuth)
# Redirect URI: https://your-app-domain/api/auth/notion/callback
# -----------------------------------------------------------------------------
NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_CLIENT_SECRET=your-notion-oauth-client-secret
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback

# -----------------------------------------------------------------------------
# Deepgram (https://console.deepgram.com → API Keys)
# Used in the Chrome Extension for audio transcription (Nova-2 model)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your-deepgram-api-key

# -----------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/app/apikey)
# Used server-side only — NEVER expose this in the extension bundle
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com → Developers → API Keys)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# -----------------------------------------------------------------------------
# App Config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Clarvo AI

# Extension-specific (these are embedded at Plasmo build time via .env)
# Create apps/extension/.env with these values
# PLASMO_PUBLIC_WEB_APP_URL=http://localhost:3000
# PLASMO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# PLASMO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# DEEPGRAM_API_KEY=your-deepgram-api-key
