{
	"servers": {
		"io.github.ChromeDevTools/chrome-devtools-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"--registry",
				"https://registry.npmjs.org",
				"chrome-devtools-mcp@0.18.1"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.18.1"
		},
		"stitch": {
			"url": "https://stitch.googleapis.com/mcp",
			"type": "http",
			"headers": {
				"Accept": "application/json",
				"X-Goog-Api-Key": "AQ.Ab8RN6K9tenrO8pVd9y3L1t32LTyQMYviLhXeuG3YZFShp5W1w"
			}
		},
		"com.postman/postman-mcp-server": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@postman/postman-mcp-server@2.7.1"
			],
			"env": {
				"POSTMAN_API_KEY": "${input:POSTMAN_API_KEY}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "2.7.1"
		},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.0.1-seed"
		},
		"notion": {
			"type": "http",
			"url": "https://mcp.notion.com/mcp"
		}
	},
	"inputs": [
		{
			"id": "POSTMAN_API_KEY",
			"type": "promptString",
			"description": "A valid Postman API key.",
			"password": true
		}
	]
}